{
  "name": "@pai/memory",
  "version": "0.1.0",
  "description": "7-layer agent memory. Persistent. Verifiable. Shared.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./layers": {
      "import": "./dist/layers/index.js",
      "types": "./dist/layers/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./integration": {
      "import": "./dist/integration/index.js",
      "types": "./dist/integration/index.d.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "docs": "typedoc --out docs/api src"
  },
  "keywords": [
    "memory",
    "agent",
    "vector",
    "pgvector",
    "sqlite-vec",
    "qdrant",
    "trust-chain",
    "sigstore",
    "firestore",
    "r2",
    "parquet"
  ],
  "author": "Mohamed Abdelaziz <momtaz2727@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pai-list/PAI-Memory"
  },
  "bugs": {
    "url": "https://github.com/pai-list/PAI-Memory/issues"
  },
  "homepage": "https://github.com/pai-list/PAI-Memory#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "hono": "^4.6.5",
    "zod": "^3.23.8",
    "viem": "^2.21.0",
    "@cloudflare/workers-types": "^5.20260722.1",
    "sqlite-vec": "^0.1.6",
    "pgvector": "^0.2.0",
    "@qdrant/js-client-rest": "^1.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^22.7.0",
    "typescript": "^5.7.0",
    "tsc-alias": "^1.8.10",
    "wrangler": "^4.113.0",
    "vitest": "^2.1.1",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.11.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "tsx": "^4.19.0",
    "typedoc": "^0.26.0"
  }
}